{
  "name": "axiom-guard",
  "version": "0.5.0",
  "description": "Deterministic runtime security for LLM apps and Claude agents: taint tracking, default-deny sinks, exfiltration blocking, hash-chained audit.",
  "keywords": [
    "llm",
    "ai-security",
    "prompt-injection",
    "agents",
    "claude",
    "anthropic",
    "guardrails",
    "taint-tracking",
    "dlp",
    "rag",
    "exfiltration"
  ],
  "homepage": "https://zoniin.github.io/axiom/",
  "bugs": {
    "url": "https://github.com/zoniin/axiom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoniin/axiom.git"
  },
  "license": "MIT",
  "author": "zoniin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    }
  },
  "bin": {
    "axiom-guard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policies",
    "schemas",
    "harness/scenarios"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "tsx src/cli.ts harness --report harness/REPORT.md",
    "serve": "tsx src/cli.ts serve",
    "example": "tsx examples/rag-pipeline.ts",
    "schemas": "tsx scripts/emit-schemas.ts",
    "check": "npm run playground:build && npm run lint && npm run typecheck && npm run coverage && npm run harness",
    "bench": "tsx scripts/bench.ts",
    "playground:build": "tsx playground/build.ts",
    "playground": "tsx playground/build.ts && tsx playground/serve.ts",
    "example:agent": "tsx examples/claude-agent.ts",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "npm run build",
    "pack:test": "node scripts/pack-test.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.3",
    "playwright": "1.65.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
