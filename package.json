{
  "name": "axiom-guard",
  "version": "0.4.0",
  "description": "Deterministic, provenance-aware runtime security gateway for LLM applications: prompt injection, exfiltration, and sink control.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    }
  },
  "bin": {
    "axiom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policies",
    "schemas",
    "harness/scenarios"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "tsx src/cli.ts harness --report harness/REPORT.md",
    "serve": "tsx src/cli.ts serve",
    "example": "tsx examples/rag-pipeline.ts",
    "schemas": "tsx scripts/emit-schemas.ts",
    "check": "npm run playground:build && npm run lint && npm run typecheck && npm run coverage && npm run harness",
    "bench": "tsx scripts/bench.ts",
    "playground:build": "tsx playground/build.ts",
    "playground": "tsx playground/build.ts && tsx playground/serve.ts",
    "example:agent": "tsx examples/claude-agent.ts",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "ai-security",
    "guardrails",
    "dlp",
    "rag"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoniin/axiom.git"
  },
  "homepage": "https://zoniin.github.io/axiom/",
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
